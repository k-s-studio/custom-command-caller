{
    "params": {
        "m_EXTS_DIR": "editor/vscode-cccrouter-syntax",
        "m_PROTECTED_BRANCHES": ["main", "master", "production"]
    },
    "commands": {
        "hide": "Add-Content .git/info/exclude \"`ncccrouter.json\"",
        "profile": "notepad $PROFILE.CurrentUserAllHosts",
        "git": {
            "push": "if ((git rev-parse --abbrev-ref HEAD) -notin $m_PROTECTED_BRANCHES) { git push }",
            "uncommit ^0=1 ^1=--soft": "git reset HEAD~^0 ^1",
            "user ^0 ^1": "git config --local user.name ^0; git config --local user.email ^1",
            "exclude ^0": "Add-Content .git/info/exclude ^0"
        }
    }
}
