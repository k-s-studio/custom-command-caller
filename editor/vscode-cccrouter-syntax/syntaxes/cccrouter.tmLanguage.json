{
    "name": "CCC Router Injection",
    "scopeName": "source.cccrouter.injection",
    "injectionSelector": "L:string.quoted.double.json",
    "patterns": [
        { "include": "#placeholder" },
        { "include": "#positional" }
    ],
    "repository": {
        "placeholder": {
            "match": "\\$\\{[A-Za-z_]\\w*\\}|\\$[A-Za-z_]\\w*",
            "name": "variable.parameter.placeholder.cccrouter"
        },
        "positional": {
            "match": "\\{\\d+=[^{}]*\\}|\\{\\d+\\}",
            "name": "variable.parameter.positional.cccrouter"
        }
    }
}
