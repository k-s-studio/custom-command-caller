{
    "name": "cccrouter-syntax",
    "displayName": "CCC Router Syntax",
    "description": "Syntax highlighting for cccrouter.json that highlights $PARAM placeholders inside command templates",
    "version": "0.0.7",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": ["Programming Languages"],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:json",
        "onLanguage:jsonc"
    ],
    "contributes": {
        "semanticTokenTypes": [
            {
                "id": "cccPlaceholder",
                "description": "cccrouter ${VAR} / $VAR placeholder"
            },
            {
                "id": "cccPositional",
                "description": "cccrouter {n} / {n=default} positional argument"
            }
        ],
        "semanticTokenScopes": [
            {
                "scopes": {
                    "cccPlaceholder": ["variable.parameter.placeholder.cccrouter"],
                    "cccPositional": ["variable.parameter.positional.cccrouter"]
                }
            }
        ],
        "configurationDefaults": {
            "editor.semanticTokenColorCustomizations": {
                "rules": {
                    "cccPlaceholder": { "foreground": "#11bee9", "fontStyle": "bold" },
                    "cccPositional": { "foreground": "#ccc059", "fontStyle": "bold" }
                }
            }
        }
    }
}
