{
    "name": "cccrouter-syntax",
    "displayName": "CCC Router Syntax",
    "description": "Syntax highlighting for cccrouter.json that highlights $PARAM placeholders inside command templates",
    "version": "0.0.7",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": ["Programming Languages"],
    "contributes": {
        "grammars": [
            {
                "scopeName": "source.cccrouter.injection",
                "path": "./syntaxes/cccrouter.tmLanguage.json",
                "injectTo": ["source.json"]
            }
        ],
        "configurationDefaults": {
            "editor.tokenColorCustomizations": {
                "textMateRules": [
                    {
                        "scope": "variable.parameter.placeholder.cccrouter",
                        "settings": { "foreground": "#11bee9", "fontStyle": "bold" }
                    },
                    {
                        "scope": "variable.parameter.positional.cccrouter",
                        "settings": { "foreground": "#ccc059", "fontStyle": "bold" }
                    }
                ]
            }
        }
    }
}
